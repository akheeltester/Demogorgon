# DEMOGORGON Configuration
# ========================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
#
# The LLM manager reads config in this priority order:
#   1. DEMOGORGON_* vars (recommended)
#   2. LLM_* vars (legacy)
#   3. Provider-specific vars (OPENROUTER_API_KEY, NVIDIA_API_KEY, etc.)
#
# Run `python -m demogorgon doctor` to verify your config works.

# ── Option 1: DEMOGORGON_* vars (recommended) ───────────────────
# DEMOGORGON_LLM_PROVIDER=openai
# DEMOGORGON_API_KEY=sk-your-key-here
# DEMOGORGON_MODEL=gpt-4o-mini
# DEMOGORGON_BASE_URL=https://api.openai.com/v1

# ── Option 2: OpenRouter (free models available) ────────────────
# Sign up at https://openrouter.ai/keys
# OPENROUTER_API_KEY=sk-or-v1-your-key-here
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# PRIMARY_MODEL=nvidia/llama-3.1-nemotron-70b-instruct:free

# ── Option 3: Anthropic ─────────────────────────────────────────
# LLM_PROVIDER=anthropic
# LLM_API_KEY=sk-ant-your-key-here
# LLM_MODEL=claude-sonnet-4-20250514

# ── Option 4: DeepSeek ──────────────────────────────────────────
# LLM_PROVIDER=deepseek
# LLM_API_KEY=your-deepseek-key
# LLM_MODEL=deepseek-chat

# ── Option 5: Ollama (local, no API key needed) ────────────────
# LLM_PROVIDER=ollama
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3.1:8b

# ── Option 6: NVIDIA NIM ───────────────────────────────────────
# NVIDIA_API_KEY=nvapi-your-key-here
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# ── Fallback Provider (optional) ────────────────────────────────
# If primary provider fails, try this one
# DEMOGORGON_FALLBACK_PROVIDER=openrouter
# DEMOGORGON_FALLBACK_MODEL=meta-llama/llama-3.2-11b-vision-instruct:free

# ── Retry & Timeout ─────────────────────────────────────────────
# DEMOGORGON_LLM_MAX_RETRIES=2
# DEMOGORGON_LLM_TIMEOUT=60
