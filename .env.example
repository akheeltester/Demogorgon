# DEMOGORGON Configuration
# ========================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ── LLM Provider ────────────────────────────────────────────────
# Supported: openai, openrouter, anthropic, deepseek, ollama
DEMOGORGON_LLM_PROVIDER=openai

# API key for the primary provider
DEMOGORGON_API_KEY=

# Model to use (provider-specific)
DEMOGORGON_MODEL=gpt-4o-mini

# Base URL for OpenAI-compatible providers
# OpenAI: https://api.openai.com/v1
# OpenRouter: https://openrouter.ai/api/v1
# DeepSeek: https://api.deepseek.com/v1
# Ollama: http://localhost:11434/v1
DEMOGORGON_BASE_URL=

# ── Fallback Provider ───────────────────────────────────────────
# Optional: if primary provider fails, try this one
# DEMOGORGON_FALLBACK_PROVIDER=anthropic
# DEMOGORGON_FALLBACK_MODEL=claude-sonnet-4-20250514

# ── Retry & Timeout ─────────────────────────────────────────────
DEMOGORGON_LLM_MAX_RETRIES=2
DEMOGORGON_LLM_TIMEOUT=60

# ── Live Testing ────────────────────────────────────────────────
# Set to 1 to enable live LLM integration tests (costs money)
# DEMOGORGON_LIVE_LLM_TEST=0

# ── Legacy Environment Variables ────────────────────────────────
# These are read if DEMOGORGON_ vars are not set
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o-mini
# LLM_API_KEY=
# LLM_BASE_URL=
