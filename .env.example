# DEMOGORGON Configuration
# ========================
# Run: python -m demogorgon doctor  to verify your config
#
# Supported providers: openai, openrouter, anthropic, gemini, deepseek, ollama
# The LLM manager auto-detects provider from env vars in this priority:
#   1. DEMOGORGON_* vars (recommended)
#   2. LLM_* vars (legacy)
#   3. Provider-specific vars (OPENROUTER_API_KEY, GEMINI_API_KEY, etc.)

# ── Option 1: OpenAI ───────────────────────────────────────────
# DEMOGORGON_LLM_PROVIDER=openai
# DEMOGORGON_API_KEY=sk-your-openai-key
# DEMOGORGON_MODEL=gpt-4o-mini
# DEMOGORGON_BASE_URL=https://api.openai.com/v1

# ── Option 2: OpenRouter (200+ models, free tier available) ────
# Sign up at https://openrouter.ai/keys
# DEMOGORGON_LLM_PROVIDER=openrouter
# DEMOGORGON_API_KEY=sk-or-v1-your-key
# DEMOGORGON_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# ── Option 3: Anthropic Claude ─────────────────────────────────
# DEMOGORGON_LLM_PROVIDER=anthropic
# DEMOGORGON_API_KEY=sk-ant-your-key
# DEMOGORGON_MODEL=claude-sonnet-4-20250514

# ── Option 4: Google Gemini ────────────────────────────────────
# Get key at https://aistudio.google.com/apikey
# DEMOGORGON_LLM_PROVIDER=gemini
# DEMOGORGON_API_KEY=your-gemini-key
# DEMOGORGON_MODEL=gemini-2.0-flash

# ── Option 5: DeepSeek ─────────────────────────────────────────
# DEMOGORGON_LLM_PROVIDER=deepseek
# DEMOGORGON_API_KEY=your-deepseek-key
# DEMOGORGON_MODEL=deepseek-chat

# ── Option 6: Ollama (local, no API key) ──────────────────────
# DEMOGORGON_LLM_PROVIDER=ollama
# DEMOGORGON_BASE_URL=http://localhost:11434/v1
# DEMOGORGON_MODEL=llama3.1:8b

# ── Fallback (optional) ────────────────────────────────────────
# If primary provider fails, try this one
# DEMOGORGON_FALLBACK_PROVIDER=openrouter
# DEMOGORGON_FALLBACK_MODEL=meta-llama/llama-3.2-11b-vision-instruct:free

# ── Retry & Timeout ─────────────────────────────────────────────
# DEMOGORGON_LLM_MAX_RETRIES=2
# DEMOGORGON_LLM_TIMEOUT=60
