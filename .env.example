# ╔═══════════════════════════════════════════════════════════════╗
# ║  DEMOGORGON Configuration                                    ║
# ║  Copy this file to .env and fill in your values             ║
# ╚═══════════════════════════════════════════════════════════════╝

# ─── LLM Provider ──────────────────────────────────────────────
# Choose one: openai, anthropic, openrouter, groq, ollama, custom
LLM_PROVIDER=openrouter

# API key for your chosen provider
LLM_API_KEY=

# Model to use (provider-specific)
# Examples:
#   openai: gpt-4o, gpt-4o-mini
#   anthropic: claude-sonnet-4-20250514, claude-3-5-haiku-20241022
#   openrouter: nvidia/llama-3.1-nemotron-70b-instruct:free
#   groq: llama-3.1-70b-versatile
#   ollama: llama3.1:8b
LLM_MODEL=

# Base URL for custom/OpenAI-compatible providers
LLM_BASE_URL=

# ─── Provider-Specific Keys ────────────────────────────────────
# Only fill in the ones you're using

# OpenRouter (https://openrouter.ai)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# OpenAI (https://platform.openai.com)
OPENAI_API_KEY=

# Anthropic (https://console.anthropic.com)
ANTHROPIC_API_KEY=

# Groq (https://console.groq.com)
GROQ_API_KEY=

# ─── Burp Suite Integration ────────────────────────────────────
# Set to true if using Burp Suite
BURP_ENABLED=false
BURP_API_URL=http://127.0.0.1:1337
BURP_PROXY_URL=http://127.0.0.1:8080

# ─── Proxy ─────────────────────────────────────────────────────
# HTTP proxy for all outbound requests (optional)
HTTP_PROXY=

# ─── Browser ───────────────────────────────────────────────────
# Run browser in headless mode (default: true)
BROWSER_HEADLESS=true

# ─── Rate Limiting ─────────────────────────────────────────────
# Seconds between requests (default: 1.0)
RATE_LIMIT=1.0

# Maximum requests per engagement (default: 10000)
MAX_REQUESTS=10000

# ─── Storage ───────────────────────────────────────────────────
# Directory for engagement data
WORKSPACE_DIR=./engagements

# ─── Notifications (Optional) ──────────────────────────────────
# Discord webhook for notifications
DISCORD_WEBHOOK=

# Telegram bot token and chat ID
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
